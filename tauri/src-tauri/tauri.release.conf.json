{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "ra-tauri",
    "version": "1.0.0",
    "identifier": "com.radiantabyss.tauri",
    "build": {
        "frontendDist": "../front",
        "beforeBuildCommand": "npm run release:front",
        "beforeDevCommand": "npm run release:front"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [{
            "label": "main",
            "title": "ra-tauri",
            "width": 1200,
            "height": 700,
            "minWidth": 600,
            "minHeight": 400,
            "visible": false,
            "center": true,
            "decorations": true,
            "resizable": true,
            "url": "index.html",
            "devtools": false
        }],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": ["**"]
            }
        }
    },
    "bundle": {
        "active": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "createUpdaterArtifacts": true
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://example.com/desktop/update/{{target}}/{{arch}}/{{bundle_type}}/{{current_version}}"
            ],
            "pubkey": ""
        }
    }
}
