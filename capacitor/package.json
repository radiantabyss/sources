{
    "name": "ra-capacitor",
    "author": "radiantabyss.com",
    "description": "ra-capacitor",
    "license": "Private",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build:front": "npm --prefix ../front run build",
        "build:front:release": "npm --prefix ../front run build:release",
        "build:app": "vite build",
        "build": "node scripts/build.mjs",
        "build:release": "node scripts/build.mjs --release",
        "serve": "node scripts/serve.mjs",
        "sync": "npm run build && cap sync",
        "sync:release": "npm run build:release && cap sync",
        "add:android": "npm run build && cap add android",
        "open:android": "cap open android",
        "run:android": "npm run build && cap sync android && cap run android"
    },
    "dependencies": {
        "@aparajita/capacitor-secure-storage": "^7.1.6",
        "@capacitor/android": "^7.0.0",
        "@capacitor/app": "^7.0.0",
        "@capacitor/core": "^7.0.0",
        "@capacitor/preferences": "^7.0.0",
        "@radiantabyss/capacitor": "^1.0.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^7.0.0",
        "fs-extra": "^11.3.3",
        "vite": "^5.3.1"
    }
}
